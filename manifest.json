{
  "manifest_version": 3,
  "name": "Markdown for Agents Detector",
  "version": "1.0.0",
  "description": "Detects if a page supports markdown responses (Cloudflare Markdown for Agents)",
  "permissions": ["tabs", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/inactive.png",
      "48": "icons/inactive.png",
      "128": "icons/inactive.png"
    }
  },
  "icons": {
    "16": "icons/inactive.png",
    "48": "icons/inactive.png",
    "128": "icons/inactive.png"
  },
  "commands": {
    "toggle-md-viewer": {
      "suggested_key": {
        "default": "Ctrl+Shift+V",
        "mac": "Command+Shift+V"
      },
      "description": "Open/close the Markdown viewer for this page, or toggle MD/Text mode if already viewing"
    }
  }
}
